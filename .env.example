# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.

PORT=3000
LOG_LEVEL=info

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
TEMPORAL_WORKFLOW_RUN_TIMEOUT_MS=30000
TEMPORAL_CONNECT_TIMEOUT_MS=3000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=hotels
REDIS_TTL_SECONDS=300

# Mock suppliers. The worker must be able to reach the API over this URL.
SUPPLIER_BASE_URL=http://localhost:3000
SUPPLIER_TIMEOUT_MS=5000
SUPPLIER_LATENCY_MS=150

# Start a supplier in a failed state (also togglable at runtime, see README).
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
