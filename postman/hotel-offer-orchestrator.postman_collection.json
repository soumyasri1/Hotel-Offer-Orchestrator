        },
        {
          "name": "5. GET /api/hotels - total outage returns 502",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 502 when no supplier can be reached', function () {",
                  "    pm.response.to.have.status(502);",
                  "});",
                  "",
                  "pm.test('returns a structured error rather than a stack trace', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error).to.eql('SuppliersUnavailable');",
                  "    pm.expect(body.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            },
            "description": "With both suppliers failing the workflow has nothing to work with, so it fails with AllSuppliersFailed and the API maps that to 502. Allow a few seconds: both activities retry before giving up."
          }
        },
        {
          "name": "6. GET /health - unhealthy while both are down",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 503', function () {",
                  "    pm.response.to.have.status(503);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('overall status is unhealthy', function () {",
                  "    pm.expect(body.status).to.eql('unhealthy');",
                  "});",
                  "",
                  "pm.test('both suppliers are reported down', function () {",
                  "    pm.expect(body.dependencies.suppliers['Supplier A'].status).to.eql('down');",
                  "    pm.expect(body.dependencies.suppliers['Supplier B'].status).to.eql('down');",
