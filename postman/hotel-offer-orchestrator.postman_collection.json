    {
      "name": "Supplier outage simulation",
      "description": "Run these requests in order. They take Supplier A down, show the API still answering from Supplier B alone, then take B down too to show the total-outage path, and finally restore both.",
      "item": [
        {
          "name": "1. Take Supplier A down",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier A is now failing', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().state.down).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"down\": true\n}" },
            "url": {
              "raw": "{{baseUrl}}/suppliers/A/control",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "A", "control"]
            },
            "description": "Makes the mock Supplier A endpoint return 503 until it is restored. The Temporal activity retries, gives up, and the workflow carries on with Supplier B."
          }
        },
        {
          "name": "2. GET /health - reports the degraded supplier",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('still returns 200 - the service can serve requests', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('overall status is degraded', function () {",
                  "    pm.expect(body.status).to.eql('degraded');",
                  "});",
                  "",
                  "pm.test('names Supplier A as the one that is down', function () {",
                  "    pm.expect(body.dependencies.suppliers['Supplier A'].status).to.eql('down');",
                  "    pm.expect(body.dependencies.suppliers['Supplier B'].status).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "3. GET /api/hotels - served from Supplier B alone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('still returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('every offer now comes from Supplier B', function () {",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    body.forEach(h => pm.expect(h.supplier).to.eql('Supplier B'));",
                  "});",
                  "",
                  "pm.test('Supplier A-only hotels are absent', function () {",
                  "    pm.expect(body.map(h => h.name)).to.not.include('Levridge');",
                  "});",
                  "",
                  "pm.test('Holtin falls back to the Supplier B price', function () {",
                  "    pm.expect(body.find(h => h.name === 'Holtin').price).to.eql(5340);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            },
            "description": "Takes a couple of seconds: the activity retries Supplier A three times before the workflow proceeds without it."
          }
        },
        {
          "name": "4. Take Supplier B down as well",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier B is now failing too', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().state.down).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"down\": true\n}" },
            "url": {
              "raw": "{{baseUrl}}/suppliers/B/control",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "B", "control"]
