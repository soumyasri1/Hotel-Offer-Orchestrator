{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Aggregates overlapping hotel offers from two mock suppliers, dedupes by hotel name, picks the best offer per hotel via a Temporal workflow, and filters by price inside Redis.\n\nRun the stack first:\n\n    docker compose up --build\n\nThen run this collection top to bottom. The `baseUrl` variable defaults to http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health - both suppliers healthy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200 while every dependency is up', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('overall status is ok', function () {",
                  "    pm.expect(body.status).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('reports on both suppliers', function () {",
                  "    pm.expect(body.dependencies.suppliers['Supplier A'].status).to.eql('up');",
                  "    pm.expect(body.dependencies.suppliers['Supplier B'].status).to.eql('up');",
                  "});",
                  "",
                  "pm.test('reports on redis and temporal', function () {",
                  "    pm.expect(body.dependencies.redis.status).to.eql('up');",
                  "    pm.expect(body.dependencies.temporal.status).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Reports each dependency separately: both mock suppliers, Redis and Temporal.\n\n- `ok` - everything reachable (200)\n- `degraded` - one supplier down, searches still served from the other (200)\n- `unhealthy` - Redis/Temporal down, or both suppliers down (503)"
          }
        }
      ]
    },
    {
      "name": "Hotels",
      "item": [
        {
          "name": "GET /api/hotels?city=delhi - valid city with overlaps",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns an array', function () {",
                  "    pm.expect(body).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('every hotel name appears exactly once', function () {",
                  "    const names = body.map(h => h.name.toLowerCase());",
                  "    pm.expect(new Set(names).size).to.eql(names.length);",
                  "});",
                  "",
                  "pm.test('each entry has the documented shape', function () {",
                  "    body.forEach(function (hotel) {",
                  "        pm.expect(hotel).to.have.all.keys('name', 'price', 'supplier', 'commissionPct');",
                  "        pm.expect(hotel.price).to.be.a('number');",
                  "    });",
                  "});",
                  "",
                  "pm.test('results are sorted by price ascending', function () {",
                  "    const prices = body.map(h => h.price);",
                  "    pm.expect(prices).to.eql(prices.slice().sort((a, b) => a - b));",
                  "});",
                  "",
                  "pm.test('Holtin resolves to the cheaper Supplier B offer', function () {",
                  "    const holtin = body.find(h => h.name === 'Holtin');",
                  "    pm.expect(holtin, 'Holtin should be present for delhi').to.be.an('object');",
                  "    pm.expect(holtin.price).to.eql(5340);",
                  "    pm.expect(holtin.supplier).to.eql('Supplier B');",
                  "});",
                  "",
                  "pm.test('Radison resolves to the cheaper Supplier A offer', function () {",
                  "    const radison = body.find(h => h.name === 'Radison');",
                  "    pm.expect(radison.price).to.eql(5900);",
                  "    pm.expect(radison.supplier).to.eql('Supplier A');",
                  "});",
                  "",
                  "pm.test('hotels offered by a single supplier are kept', function () {",
                  "    pm.expect(body.find(h => h.name === 'Levridge'), 'Supplier A only').to.be.an('object');",
                  "    pm.expect(body.find(h => h.name === 'Oberoy'), 'Supplier B only').to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            },
            "description": "Delhi is served by both suppliers with four overlapping names, so this exercises the full comparison:\n\n| Hotel | Supplier A | Supplier B | Winner |\n|---|---|---|---|\n| Holtin | 6000 | 5340 | B |\n| Radison | 5900 | 6150 | A |\n| Tajj | 8200 | 8750 | A |\n| Levridge | 4200 | - | A |\n| Oberoy | - | 11200 | B |"
          }
        },
        {
          "name": "GET /api/hotels - with price range (filtered in Redis)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const min = 5000;",
                  "const max = 9000;",
                  "",
                  "pm.test('every result falls inside the requested range', function () {",
                  "    body.forEach(function (hotel) {",
                  "        pm.expect(hotel.price).to.be.at.least(min);",
                  "        pm.expect(hotel.price).to.be.at.most(max);",
                  "    });",
                  "});",
                  "",
                  "pm.test('excludes hotels priced outside the range', function () {",
                  "    const names = body.map(h => h.name);",
                  "    pm.expect(names).to.not.include('Levridge');",
                  "    pm.expect(names).to.not.include('Oberoy');",
                  "});",
                  "",
                  "pm.test('keeps the in-range winners', function () {",
                  "    const names = body.map(h => h.name);",
                  "    pm.expect(names).to.include('Holtin');",
                  "    pm.expect(names).to.include('Radison');",
                  "    pm.expect(names).to.include('Tajj');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=9000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "5000" },
                { "key": "maxPrice", "value": "9000" }
              ]
            },
            "description": "Bounds are inclusive and applied by a ZRANGEBYSCORE inside Redis, not in Node. Levridge (4200) and Oberoy (11200) drop out."
          }
        },
        {
          "name": "GET /api/hotels - minPrice only",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test('no result is cheaper than minPrice', function () {",
                  "    pm.response.json().forEach(function (hotel) {",
                  "        pm.expect(hotel.price).to.be.at.least(8000);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=8000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "8000" }
              ]
            },
            "description": "An omitted bound becomes -inf / +inf, so either bound can be supplied alone."
          }
        },
        {
          "name": "GET /api/hotels - price range matching nothing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test('returns an empty array', function () {",
                  "    pm.expect(pm.response.json()).to.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=90000&maxPrice=99000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "90000" },
                { "key": "maxPrice", "value": "99000" }
              ]
            },
            "description": "An empty match is a valid result, not an error: 200 with []."
          }
        },
        {
          "name": "GET /api/hotels?city=jaipur - city with no results",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test('returns an empty array', function () {",
                  "    pm.expect(pm.response.json()).to.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=jaipur",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "jaipur" }]
            },
            "description": "Neither supplier serves jaipur. Both calls succeed and return [], so the workflow completes normally with an empty list."
          }
        },
        {
          "name": "GET /api/hotels?city=mumbai - second city",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Holtin resolves to the cheaper Supplier B offer', function () {",
                  "    const holtin = body.find(h => h.name === 'Holtin');",
                  "    pm.expect(holtin.price).to.eql(7050);",
                  "    pm.expect(holtin.supplier).to.eql('Supplier B');",
                  "});",
                  "",
                  "pm.test('cities are cached independently of delhi', function () {",
                  "    pm.expect(body.map(h => h.name)).to.not.include('Levridge');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=mumbai",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "mumbai" }]
            },
            "description": "Confirms each city gets its own Redis key space."
          }
        }
      ]
    },
