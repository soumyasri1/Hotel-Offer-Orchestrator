{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Aggregates overlapping hotel offers from two mock suppliers, dedupes by hotel name and selects the best offer, orchestrated with Temporal and filtered in Redis.",
  "main": "dist/api/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "nodemon",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev:api": "nodemon",
    "dev:worker": "nodemon --watch src --ext ts --exec \"tsx src/temporal/worker.ts\"",
    "test": "node --import tsx --test test/dedupe.test.ts test/redisFilter.test.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.6",
    "@temporalio/client": "^1.11.6",
    "@temporalio/common": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
